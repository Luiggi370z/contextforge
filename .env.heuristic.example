# =============================================================================
# Mode A — HEURISTIC (default, zero API keys, deterministic)
# =============================================================================
# Pure-Python provider: rules + token overlap + score thresholds. No LLM calls.
# Best for a quick local spin and for what `pytest -m eval` exercises.
#
# Setup:
#   cp .env.heuristic.example backend/.env
#   just up && (cd backend && uv sync --extra ml) && just migrate
#   just api-dev      # +  just worker  (uploads)  +  just web-dev
#   just seed
# Note: EMBEDDING_BACKEND=sentence-transformers needs `uv sync --extra ml`.
#       For a fully dependency-free run set EMBEDDING_BACKEND=hash.
# =============================================================================

# Application
APP_ENV=development
LOG_LEVEL=INFO
API_HOST=0.0.0.0
API_PORT=8000

# PostgreSQL (host port 5434 via docker compose)
DATABASE_URL=postgresql+asyncpg://contextforge:contextforge@localhost:5434/contextforge

# Async ingestion queue (file uploads)
REDIS_URL=redis://localhost:6379

# Retrieval store
RETRIEVAL_BACKEND=qdrant
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=contextforge

# LLM — heuristic needs no keys
LLM_PROVIDER=heuristic

# Embeddings (sentence-transformers MiniLM, 384-dim; use `hash` for no-torch runs)
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_BACKEND=sentence-transformers
EMBEDDING_DIM=384

# Retrieval
RETRIEVAL_TOP_K=20
RERANK_TOP_N=5
RERANK_BACKEND=lexical
GRADE_MIN_SCORE=0.25
GRADE_MIN_SCORE_CROSS_ENCODER=0.0

# CORS (Vite dev server)
CORS_ORIGINS=http://localhost:5173

# Observability (optional Langfuse — off by default)
LANGFUSE_ENABLED=false
LANGFUSE_PUBLIC_KEY=pk-lf-contextforge-dev
LANGFUSE_SECRET_KEY=sk-lf-contextforge-dev
LANGFUSE_HOST=http://localhost:3000
