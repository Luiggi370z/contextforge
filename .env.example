# Application
APP_ENV=development
LOG_LEVEL=INFO
API_HOST=0.0.0.0
API_PORT=8000

# PostgreSQL (host port 5433 when using docker compose)
DATABASE_URL=postgresql+asyncpg://contextforge:contextforge@localhost:5433/contextforge

# Retrieval store: qdrant (default) | postgres (pgvector + FTS — not implemented yet).
# UI may override per request once TODO(retrieval-backend-ui) is implemented.
RETRIEVAL_BACKEND=qdrant

# Qdrant (used when RETRIEVAL_BACKEND=qdrant)
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=contextforge

# LLM
LLM_PROVIDER=heuristic
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Embeddings (set EMBEDDING_BACKEND=hash for fast tests without torch)
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_BACKEND=sentence-transformers

# Retrieval
RETRIEVAL_TOP_K=20
RERANK_TOP_N=5
# lexical (default) | cross_encoder (requires sentence-transformers / ml extra)
RERANK_BACKEND=lexical
GRADE_MIN_SCORE=0.25

# CORS (Vite dev server)
CORS_ORIGINS=http://localhost:5173
