# Application
APP_ENV=development
LOG_LEVEL=INFO
API_HOST=0.0.0.0
API_PORT=8000

# PostgreSQL (host port 5434 when using docker compose; Nexus often uses 5432)
DATABASE_URL=postgresql+asyncpg://contextforge:contextforge@localhost:5434/contextforge

# Retrieval store: qdrant (default) | postgres (pgvector + FTS — not implemented yet).
# UI may override per request once TODO(retrieval-backend-ui) is implemented.
RETRIEVAL_BACKEND=qdrant

# Qdrant (used when RETRIEVAL_BACKEND=qdrant)
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=contextforge

# LLM
# heuristic | openai (instructor) | pydantic_ai | ollama
LLM_PROVIDER=heuristic
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# For Ollama mode:
#   1) run: ollama serve
#   2) pull: ollama pull llama3.2

# Embeddings (set EMBEDDING_BACKEND=hash for fast tests without torch)
# Fully-offline combo (bge-m3 dense+sparse from one model + gemma2): see LOCAL_FIRST.md
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_BACKEND=sentence-transformers
# 384 for all-MiniLM-L6-v2; 1024 for bge-m3. Keys the Qdrant collection (contextforge_<dim>).
EMBEDDING_DIM=384

# Retrieval
RETRIEVAL_TOP_K=20
RERANK_TOP_N=5
# lexical (default) | cross_encoder (requires: uv sync --extra ml)
RERANK_BACKEND=lexical
# Min rerank/relevance score to use a chunk (lexical/dense, typically 0–1)
GRADE_MIN_SCORE=0.25
# Min cross-encoder logit when RERANK_BACKEND=cross_encoder (often ~0 for relevant pairs)
GRADE_MIN_SCORE_CROSS_ENCODER=0.0

# CORS (Vite dev server)
CORS_ORIGINS=http://localhost:5173

# Observability (optional) — self-hosted Langfuse v3 read-path tracing.
# Off by default: the app no-ops with zero overhead unless LANGFUSE_ENABLED=true.
# Start the stack with: docker compose --profile observability up -d
# The compose LANGFUSE_INIT_* vars provision these dev keys automatically.
LANGFUSE_ENABLED=false
LANGFUSE_PUBLIC_KEY=pk-lf-contextforge-dev
LANGFUSE_SECRET_KEY=sk-lf-contextforge-dev
# From the host use localhost:3000; from the api container use http://langfuse-web:3000
LANGFUSE_HOST=http://localhost:3000
