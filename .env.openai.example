# =============================================================================
# Mode B — OPENAI (hosted, best answer quality)
# =============================================================================
# Generation via OpenAI Chat + Instructor; local sentence-transformers embeddings
# and a local cross-encoder reranker.
#
# Setup:
#   cp .env.openai.example backend/.env
#   # set OPENAI_API_KEY below
#   just up && (cd backend && uv sync --extra ml) && just migrate
#   just api-dev      # +  just worker  (uploads)  +  just web-dev
#   just seed
# Note: EMBEDDING_BACKEND=sentence-transformers + RERANK_BACKEND=cross_encoder
#       both need `uv sync --extra ml`.
# =============================================================================

# Application
APP_ENV=development
LOG_LEVEL=INFO
API_HOST=0.0.0.0
API_PORT=8000

# PostgreSQL (host port 5434 via docker compose)
DATABASE_URL=postgresql+asyncpg://contextforge:contextforge@localhost:5434/contextforge

# Async ingestion queue (file uploads)
REDIS_URL=redis://localhost:6379

# Retrieval store
RETRIEVAL_BACKEND=qdrant
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=contextforge

# LLM — OpenAI
LLM_PROVIDER=openai
OPENAI_API_KEY=sk-REPLACE_ME
OPENAI_MODEL=gpt-4o-mini

# Embeddings (sentence-transformers MiniLM, 384-dim)
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_BACKEND=sentence-transformers
EMBEDDING_DIM=384

# Retrieval (cross-encoder rerank for sharper grounding/abstain)
RETRIEVAL_TOP_K=20
RERANK_TOP_N=5
RERANK_BACKEND=cross_encoder
GRADE_MIN_SCORE=0.25
GRADE_MIN_SCORE_CROSS_ENCODER=0.0

# CORS (Vite dev server)
CORS_ORIGINS=http://localhost:5173

# Observability (optional Langfuse — off by default)
LANGFUSE_ENABLED=false
LANGFUSE_PUBLIC_KEY=pk-lf-contextforge-dev
LANGFUSE_SECRET_KEY=sk-lf-contextforge-dev
LANGFUSE_HOST=http://localhost:3000
