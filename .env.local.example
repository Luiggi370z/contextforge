# =============================================================================
# Mode C — FULLY LOCAL (Ollama Gemma + BGE-M3, 100% offline)
# =============================================================================
# Generation via local Ollama (gemma2); BGE-M3 emits BOTH dense (1024) and
# sparse vectors from ONE local model; local cross-encoder reranker. No external
# API calls. See LOCAL_FIRST.md.
#
# Setup:
#   cp .env.local.example backend/.env
#   ollama pull gemma2
#   just up && (cd backend && uv sync --extra ml) && just migrate
#   just seed          # 1024-dim → fresh collection contextforge_1024 (re-seed!)
#   just api-dev       # +  just worker  (uploads)  +  just web-dev
# Note: `uv sync --extra ml` installs FlagEmbedding; BGE-M3 downloads ~2.3GB on
#       first use. Changing EMBEDDING_DIM keys a NEW Qdrant collection — re-seed.
# =============================================================================

# Application
APP_ENV=development
LOG_LEVEL=INFO
API_HOST=0.0.0.0
API_PORT=8000
MAX_UPLOAD_BYTES=10485760

# PostgreSQL (host port 5434 via docker compose)
DATABASE_URL=postgresql+asyncpg://contextforge:contextforge@localhost:5434/contextforge

# Async ingestion queue (file uploads)
REDIS_URL=redis://localhost:6379

# Retrieval store
RETRIEVAL_BACKEND=qdrant
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=contextforge

# LLM — local Ollama (Gemma). Config-only: `ollama serve` + `ollama pull gemma2`.
LLM_PROVIDER=ollama
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=gemma2

# Embeddings — BGE-M3: dense (1024) + sparse from one local model (FlagEmbedding)
EMBEDDING_BACKEND=bge-m3
EMBEDDING_DIM=1024

# Retrieval (local cross-encoder rerank)
RETRIEVAL_TOP_K=20
RERANK_TOP_N=5
RERANK_BACKEND=cross_encoder
GRADE_MIN_SCORE=0.25
GRADE_MIN_SCORE_CROSS_ENCODER=0.0

# CORS (Vite dev server)
CORS_ORIGINS=http://localhost:5173

# Observability (optional Langfuse — off by default)
LANGFUSE_ENABLED=false
LANGFUSE_PUBLIC_KEY=pk-lf-contextforge-dev
LANGFUSE_SECRET_KEY=sk-lf-contextforge-dev
LANGFUSE_HOST=http://localhost:3000
